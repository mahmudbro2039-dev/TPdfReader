## STEP 5 — TOP BAR (most important)

Layout: `[ Teena|Reader wordmark ]  [ ——— long search pill with search button inside ——— ]  [ ⋮ ]`

Behavior:
- Wordmark: left, one line, `softWrap=false`. "Teena" bold in onSurface, "Reader" light in primary.
- Search field takes all remaining width (`weight(1f)`), pill shape, height `sizes.searchHeight`, search button (circle, primary) INSIDE the pill on the right; clear (X) appears when text is not empty.
- When the search field gets focus, the wordmark animates away (fade + shrink) so the search uses the full width. Back press while focused clears focus.
- Three-dots opens the dropdown with all options (Step 6).
- Same on all 3 tabs.

```kotlin
@Composable
fun TeenaTopBar(
    query: String, onQueryChange: (String) -> Unit, onSearch: (String) -> Unit,
    menu: List<MenuAction>, modifier: Modifier = Modifier
) {
    val s = TeenaTheme.spacing; val sz = TeenaTheme.sizes
    var focused by remember { mutableStateOf(false) }
    val focusManager = LocalFocusManager.current
    BackHandler(enabled = focused) { focusManager.clearFocus() }

    Surface(color = MaterialTheme.colorScheme.background, modifier = modifier) {
        Row(
            Modifier.statusBarsPadding().height(sz.topBarHeight).padding(start = s.screenH, end = s.xs),
            verticalAlignment = Alignment.CenterVertically
        ) {
            AnimatedVisibility(
                visible = !focused,
                enter = fadeIn() + expandHorizontally(), exit = fadeOut() + shrinkHorizontally()
            ) {
                Row { BrandWordmark(); Spacer(Modifier.width(s.md)) }
            }
            TeenaSearchField(
                query = query, onQueryChange = onQueryChange, onSearch = onSearch,
                onFocusChange = { focused = it }, modifier = Modifier.weight(1f)
            )
            OverflowMenu(menu)
        }
    }
}

