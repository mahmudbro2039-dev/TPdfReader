<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="search_index.db"/>
        <exclude domain="database" path="search_index.db-wal"/>
        <exclude domain="database" path="search_index.db-shm"/>
        <exclude domain="file" path="tesseract"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="search_index.db"/>
        <exclude domain="database" path="search_index.db-wal"/>
        <exclude domain="database" path="search_index.db-shm"/>
        <exclude domain="file" path="tesseract"/>
    </device-transfer>
</data-extraction-rules>
